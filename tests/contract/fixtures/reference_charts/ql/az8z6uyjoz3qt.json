    "queryValue": "SELECT\r\n  toDateTime(toStartOfInterval(t1.event_dttm, interval 1 week)) AS dttm,\r\n  sum(1) AS events,\r\n  CASE WHEN (t1.exec_time_sec < 3) THEN '< 3 sec.' WHEN (t1.exec_time_sec < 5) THEN '< 5 sec' WHEN (t1.exec_time_sec < 10) THEN '< 10 sec' ELSE '> 10 sec' END AS category\r\nFROM \"//home/taxi-analytics/taxi-bi/datalens-meta/cdm/datalens_events\" AS t1\r\nWHERE\r\n  t1.dash_path_lvl_2 IN ({{service}}) AND t1.source IN ('Chart') AND t1.event_dttm BETWEEN toDateTime('2026-06-17T00:00:00') AND toDateTime('2026-07-16T23:59:59') AND toDateTime(toStartOfInterval(t1.event_dttm, interval 1 week)) BETWEEN toDateTime('2026-06-17T00:00:00') AND toDateTime('2026-07-16T23:59:59')\r\nGROUP BY dttm, category\r\n  ORDER BY category ASC NULLS FIRST\r\nLIMIT 1000001",
